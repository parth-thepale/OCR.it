{
  "name": "local-agent-ocr",
  "version": "0.1.0",
  "description": "OCR.it - Open-source zero-egress client-side OCR library and Agent Skill",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js",
      "require": "./dist/tools.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "keywords": [
    "ocr",
    "agent-skills",
    "webassembly",
    "tesseract",
    "llm-tools",
    "mcp",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parth-thepale/OCR.it.git"
  },
  "homepage": "https://github.com/parth-thepale/OCR.it#readme",
  "bugs": {
    "url": "https://github.com/parth-thepale/OCR.it/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
